@prefix np: <http://www.nanopub.org/nschema#> .
@prefix rel: <https://example.org/rel/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/np/demo-nanopub-01/A1> {
  <https://example.org/np/demo-nanopub-01/A1> a np:Nanopublication ;
      np:hasAssertion <https://example.org/np/demo-nanopub-01/A1/assertion> ;
      np:hasProvenance <https://example.org/np/demo-nanopub-01/A1/provenance> ;
      np:hasPublicationInfo <https://example.org/np/demo-nanopub-01/A1/pubinfo> .
  <https://example.org/np/demo-nanopub-01/A1/assertion> a np:Assertion ;
      rel:relation "located_in" ;
      rel:subject "gas hydrate" ;
      rel:object "marine sediment" ;
      rel:qualifier "site CUG-3" ;
      rel:text "Gas hydrate occurs in marine sediment at site CUG-3." .
  <https://example.org/np/demo-nanopub-01/A1/provenance> a np:Provenance ;
      prov:wasDerivedFrom <urn:doi:urn:doi:none:demo-nanopub-01> ;
      rel:paragraphId "JATS-3" ;
      rel:quote "Gas hydrate occurs in marine sediment at site CUG-3." ;
      rel:derivation "direct" .
  <https://example.org/np/demo-nanopub-01/A1/pubinfo> a np:PublicationInfo ;
      rel:caseId "demo-nanopub-01" ;
      rel:creator "skill:nanopub-assertion-export" .
}

<https://example.org/np/demo-nanopub-01/A2> {
  <https://example.org/np/demo-nanopub-01/A2> a np:Nanopublication ;
      np:hasAssertion <https://example.org/np/demo-nanopub-01/A2/assertion> ;
      np:hasProvenance <https://example.org/np/demo-nanopub-01/A2/provenance> ;
      np:hasPublicationInfo <https://example.org/np/demo-nanopub-01/A2/pubinfo> .
  <https://example.org/np/demo-nanopub-01/A2/assertion> a np:Assertion ;
      rel:relation "located_in" ;
      rel:subject "hydrate stability zone" ;
      rel:object "seafloor" ;
      rel:qualifier "base at 12 m" ;
      rel:text "The hydrate stability zone extends 12 m below the seafloor." .
  <https://example.org/np/demo-nanopub-01/A2/provenance> a np:Provenance ;
      prov:wasDerivedFrom <urn:doi:urn:doi:none:demo-nanopub-01> ;
      rel:paragraphId "JATS-3" ;
      rel:quote "The hydrate stability zone extends 12 m below the seafloor." ;
      rel:derivation "direct" .
  <https://example.org/np/demo-nanopub-01/A2/pubinfo> a np:PublicationInfo ;
      rel:caseId "demo-nanopub-01" ;
      rel:creator "skill:nanopub-assertion-export" .
}

<https://example.org/np/demo-nanopub-01/A3> {
  <https://example.org/np/demo-nanopub-01/A3> a np:Nanopublication ;
      np:hasAssertion <https://example.org/np/demo-nanopub-01/A3/assertion> ;
      np:hasProvenance <https://example.org/np/demo-nanopub-01/A3/provenance> ;
      np:hasPublicationInfo <https://example.org/np/demo-nanopub-01/A3/pubinfo> .
  <https://example.org/np/demo-nanopub-01/A3/assertion> a np:Assertion ;
      rel:relation "increases" ;
      rel:subject "dissociation pressure" ;
      rel:object "salinity" ;
      rel:qualifier "4 °C; 0→3.5 wt%; +0.9 MPa" ;
      rel:text "Dissociation pressure increases by 0.9 MPa when salinity rises from 0 to 3.5 wt% at 4 °C." .
  <https://example.org/np/demo-nanopub-01/A3/provenance> a np:Provenance ;
      prov:wasDerivedFrom <urn:doi:urn:doi:none:demo-nanopub-01> ;
      rel:paragraphId "JATS-6" ;
      rel:quote "Dissociation pressure increases by 0.9 MPa when salinity rises from 0 to 3.5 wt% at 4 °C." ;
      rel:derivation "direct" .
  <https://example.org/np/demo-nanopub-01/A3/pubinfo> a np:PublicationInfo ;
      rel:caseId "demo-nanopub-01" ;
      rel:creator "skill:nanopub-assertion-export" .
}

<https://example.org/np/demo-nanopub-01/A4> {
  <https://example.org/np/demo-nanopub-01/A4> a np:Nanopublication ;
      np:hasAssertion <https://example.org/np/demo-nanopub-01/A4/assertion> ;
      np:hasProvenance <https://example.org/np/demo-nanopub-01/A4/provenance> ;
      np:hasPublicationInfo <https://example.org/np/demo-nanopub-01/A4/pubinfo> .
  <https://example.org/np/demo-nanopub-01/A4/assertion> a np:Assertion ;
      rel:relation "exceeds" ;
      rel:subject "permeability of the sandy layer" ;
      rel:object "permeability of the clay" ;
      rel:qualifier "by one order of magnitude" ;
      rel:text "Permeability of the sandy layer is one order of magnitude higher than that of the clay." .
  <https://example.org/np/demo-nanopub-01/A4/provenance> a np:Provenance ;
      prov:wasDerivedFrom <urn:doi:urn:doi:none:demo-nanopub-01> ;
