      np:hasPublicationInfo <https://example.org/np/demo-nanopub-01/A5/pubinfo> .
  <https://example.org/np/demo-nanopub-01/A5/assertion> a np:Assertion ;
      rel:relation "has_value" ;
      rel:subject "pore-water salinity" ;
      rel:object "3.5 wt% NaCl equivalent" ;
      rel:qualifier "site CUG-3" ;
      rel:text "Pore-water salinity is 3.5 wt% NaCl equivalent." .
  <https://example.org/np/demo-nanopub-01/A5/provenance> a np:Provenance ;
      prov:wasDerivedFrom <urn:doi:urn:doi:none:demo-nanopub-01> ;
