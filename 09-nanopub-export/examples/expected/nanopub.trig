      rel:quote "Permeability of the sandy layer is one order of magnitude higher than that of the clay." ;
      rel:derivation "direct" .
  <https://example.org/np/demo-nanopub-01/A4/pubinfo> a np:PublicationInfo ;
      rel:caseId "demo-nanopub-01" ;
      rel:creator "skill:nanopub-assertion-export" .
}

<https://example.org/np/demo-nanopub-01/A5> {
  <https://example.org/np/demo-nanopub-01/A5> a np:Nanopublication ;
      np:hasAssertion <https://example.org/np/demo-nanopub-01/A5/assertion> ;
