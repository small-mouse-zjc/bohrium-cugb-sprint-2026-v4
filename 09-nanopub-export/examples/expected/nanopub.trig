      rel:relation <https://example.org/rel/located_in> ;
      rel:subject <https://example.org/np/demo-nanopub-01/ent/hydrate-stability-zone> ;
      rel:subjectLabel "hydrate stability zone" ;
      rel:subjectType "boundary" ;
      rel:object <https://example.org/np/demo-nanopub-01/ent/seafloor> ;
      rel:objectLabel "seafloor" ;
      rel:objectType "boundary" ;
      rel:qualifier "base at 12 m" ;
      rel:text "The hydrate stability zone extends 12 m below the seafloor." .
  <https://example.org/np/demo-nanopub-01/A2/provenance> a np:Provenance ;
      prov:wasDerivedFrom <urn:case:demo-nanopub-01> ;
      rel:paragraphId "JATS-3" ;
      rel:quote "The hydrate stability zone extends 12 m below the seafloor." ;
      rel:derivation "direct" .
  <https://example.org/np/demo-nanopub-01/A2/pubinfo> a np:PublicationInfo ;
      rel:caseId "demo-nanopub-01" ;
      rel:creator "skill:nanopub-assertion-export" .
}

<https://example.org/np/demo-nanopub-01/A3> {
  <https://example.org/np/demo-nanopub-01/A3> a np:Nanopublication ;
      np:hasAssertion <https://example.org/np/demo-nanopub-01/A3/assertion> ;
      np:hasProvenance <https://example.org/np/demo-nanopub-01/A3/provenance> ;
      np:hasPublicationInfo <https://example.org/np/demo-nanopub-01/A3/pubinfo> .
  <https://example.org/np/demo-nanopub-01/A3/assertion> a np:Assertion ;
      rel:relation <https://example.org/rel/increases> ;
      rel:subject <https://example.org/np/demo-nanopub-01/ent/dissociation-pressure> ;
      rel:subjectLabel "dissociation pressure" ;
      rel:subjectType "property" ;
      rel:object <https://example.org/np/demo-nanopub-01/ent/salinity> ;
      rel:objectLabel "salinity" ;
      rel:objectType "property" ;
      rel:qualifier "4 °C; 0→3.5 wt%; +0.9 MPa" ;
      rel:text "Dissociation pressure increases by 0.9 MPa when salinity rises from 0 to 3.5 wt% at 4 °C." .
  <https://example.org/np/demo-nanopub-01/A3/provenance> a np:Provenance ;
      prov:wasDerivedFrom <urn:case:demo-nanopub-01> ;
      rel:paragraphId "JATS-6" ;
      rel:quote "Dissociation pressure increases by 0.9 MPa when salinity rises from 0 to 3.5 wt% at 4 °C." ;
      rel:derivation "direct" .
  <https://example.org/np/demo-nanopub-01/A3/pubinfo> a np:PublicationInfo ;
      rel:caseId "demo-nanopub-01" ;
      rel:creator "skill:nanopub-assertion-export" .
}

<https://example.org/np/demo-nanopub-01/A4> {
  <https://example.org/np/demo-nanopub-01/A4> a np:Nanopublication ;
      np:hasAssertion <https://example.org/np/demo-nanopub-01/A4/assertion> ;
      np:hasProvenance <https://example.org/np/demo-nanopub-01/A4/provenance> ;
