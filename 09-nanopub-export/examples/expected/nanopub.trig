@prefix np: <http://www.nanopub.org/nschema#> .
@prefix rel: <https://example.org/rel/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/np/demo-nanopub-01/A1> {
  <https://example.org/np/demo-nanopub-01/A1> a np:Nanopublication ;
      np:hasAssertion <https://example.org/np/demo-nanopub-01/A1/assertion> ;
      np:hasProvenance <https://example.org/np/demo-nanopub-01/A1/provenance> ;
      np:hasPublicationInfo <https://example.org/np/demo-nanopub-01/A1/pubinfo> .
  <https://example.org/np/demo-nanopub-01/A1/assertion> a np:Assertion ;
      rel:relation <https://example.org/rel/located_in> ;
      rel:subject <https://example.org/np/demo-nanopub-01/ent/gas-hydrate> ;
      rel:subjectLabel "gas hydrate" ;
      rel:subjectType "material" ;
      rel:object <https://example.org/np/demo-nanopub-01/ent/marine-sediment> ;
      rel:objectLabel "marine sediment" ;
      rel:objectType "environment" ;
      rel:qualifier "site CUG-3" ;
      rel:text "Gas hydrate occurs in marine sediment at site CUG-3." .
  <https://example.org/np/demo-nanopub-01/A1/provenance> a np:Provenance ;
      prov:wasDerivedFrom <urn:case:demo-nanopub-01> ;
      rel:paragraphId "JATS-3" ;
      rel:quote "Gas hydrate occurs in marine sediment at site CUG-3." ;
      rel:derivation "direct" .
  <https://example.org/np/demo-nanopub-01/A1/pubinfo> a np:PublicationInfo ;
      rel:caseId "demo-nanopub-01" ;
      rel:creator "skill:nanopub-assertion-export" .
}

<https://example.org/np/demo-nanopub-01/A2> {
  <https://example.org/np/demo-nanopub-01/A2> a np:Nanopublication ;
      np:hasAssertion <https://example.org/np/demo-nanopub-01/A2/assertion> ;
      np:hasProvenance <https://example.org/np/demo-nanopub-01/A2/provenance> ;
      np:hasPublicationInfo <https://example.org/np/demo-nanopub-01/A2/pubinfo> .
