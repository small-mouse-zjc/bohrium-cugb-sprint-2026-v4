      rel:subject <https://example.org/np/demo-nanopub-01/ent/permeability-of-the-sandy-layer> ;
      rel:subjectLabel "permeability of the sandy layer" ;
      rel:subjectType "property" ;
      rel:object <https://example.org/np/demo-nanopub-01/ent/permeability-of-the-clay> ;
      rel:objectLabel "permeability of the clay" ;
      rel:objectType "property" ;
      rel:qualifier "by one order of magnitude" ;
      rel:text "Permeability of the sandy layer is one order of magnitude higher than that of the clay." .
